# Copy to .env and adjust. Never commit .env or real secrets.
# The defaults below match docker-compose.yml, so copying the file unchanged works locally.
# The values here are development defaults, not secrets: set real ones in production.

# --- API (apps/api) ---
HOST=localhost
PORT=3000
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (the Angular dev server by default).
CORS_ORIGINS=http://localhost:4200
# Rate limit: requests per window per client, window in milliseconds.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Stricter limit for POST /route (same window), because it calls BRouter.
ROUTE_RATE_LIMIT_MAX=20
# PUT /p/{id} (sharing a route) is open to anyone: keep it tight. Window in milliseconds.
SHARE_RATE_LIMIT_MAX=10
SHARE_RATE_LIMIT_WINDOW_MS=3600000
SHARE_BODY_LIMIT_BYTES=1000000
DATABASE_URL=postgres://voielibre:voielibre@localhost:5432/voielibre
BROUTER_URL=http://localhost:17777
# Copernicus GLO-30 elevation tiles read by POST /elevation (see scripts/download-relief.sh).
# Relative paths are resolved from the directory the API is started in (the workspace root).
RELIEF_DIR=data/relief
ELEVATION_RATE_LIMIT_MAX=30

# --- docker compose ---
POSTGRES_USER=voielibre
POSTGRES_PASSWORD=voielibre
POSTGRES_DB=voielibre
POSTGRES_PORT=5432
BROUTER_PORT=17777
API_PORT=3000
# Directory holding the *.rd5 routing segments (see scripts/download-segments.sh).
BROUTER_SEGMENTS_DIR=./data/brouter/segments4
TILES_PORT=8081
# Directory holding the basemap (see scripts/download-basemap.sh).
BASEMAP_DIR=./data/basemap
