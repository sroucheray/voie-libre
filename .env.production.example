# Copy to `.env` on the server (never commit it) and set real values.
# Read by docker-compose.prod.yml.

# The public name of the site: the Caddy site address and the CORS origin.
SITE_DOMAIN=voielibre.app
# Leave unset in production. ":8080" tries the stack locally over plain HTTP
# (with HTTP_PORT=8080 and HTTPS_PORT=8443).
# SITE_ADDRESS=

# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=voielibre
POSTGRES_DB=voielibre

# Where the data lives on the server (see scripts/download-segments.sh and download-basemap.sh).
BROUTER_SEGMENTS_DIR=./data/brouter/segments4
BASEMAP_DIR=./data/basemap

# Optional.
# LOG_LEVEL=info
# RATE_LIMIT_MAX=100
# ROUTE_RATE_LIMIT_MAX=120
# GEOCODE_RATE_LIMIT_MAX=60
# GEOCODER_URL=https://photon.komoot.io
