{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/i18n/*.json",
          "/maplibre/*.mjs",
          "/icons/*.png"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "basemap-assets",
      "urls": [
        "http://localhost:8081/fonts/**",
        "http://localhost:8081/sprites/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 2000,
        "maxAge": "365d"
      }
    }
  ]
}
