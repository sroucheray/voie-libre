# One origin for everything (see docs/features/deploy.md):
#   /api/*    the API (prefix removed)
#   /tiles/*  the basemap server (PMTiles, fonts, sprites; prefix removed, Range requests pass)
#   the rest  the Angular app, with an index.html fallback for its routes
# SITE_ADDRESS is the domain in production (Caddy then gets a certificate by itself) and ":8080"
# to try the stack locally over plain HTTP.
{
	# The firewall opens 80 and 443 over TCP only.
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS:localhost} {
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Not compressed here: PMTiles tiles are already compressed and ranges must stay exact.
	handle_path /tiles/* {
		reverse_proxy tiles:80
	}

	handle {
		encode zstd gzip
		root * /srv

		# Everything is checked at every visit (cheap, with the ETag), so an update of the shell or of
		# the service worker reaches a device that already has the app; the built files carry a hash
		# in their name and are kept for good. (`try_files` rewrites to index.html after the headers,
		# so the default cannot be limited to a path.)
		@hashed path_regexp hashed ^/(chunk|main|polyfills|styles)-[A-Za-z0-9_-]+\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path_regexp hashed2 ^/(chunk|main|polyfills|styles)-[A-Za-z0-9_-]+\.(js|css)$
		header @unhashed Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
