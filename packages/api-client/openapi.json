                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code", "message"],
                  "properties": {
                    "code": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["invalid_request"]
                        },
                        {
                          "type": "string",
                          "enum": ["not_found"]
                        },
                        {
                          "type": "string",
                          "enum": ["already_exists"]
                        },
                        {
                          "type": "string",
                          "enum": ["forbidden"]
                        },
                        {
                          "type": "string",
                          "enum": ["payload_too_large"]
                        }
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
